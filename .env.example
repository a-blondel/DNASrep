# Copy to `.env` and adjust.

# Host IP to publish port 443 on.
# This is the IP your DNS must return for gate1.<region>.dnas.playstation.org.
# Leave 0.0.0.0 to listen on all interfaces.
HOST_IP=0.0.0.0

# Region served by this deployment: eu, us or jp.
# One region per deployment (the PS2 sends no SNI and validates the certificate
# CN, so a single IP can only serve one region).
REGION=eu

# Certificate handling:
#   true  = generate at first start if missing (default)
#   force = regenerate on every start
#   false = do not generate, use the certs mounted in ./certs
REGEN_CERTS=true
